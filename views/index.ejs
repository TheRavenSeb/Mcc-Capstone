<link rel="stylesheet" href="/css/theme.css">

<main class="home-page">
	<section class="home-intro" aria-labelledby="home-heading">
		<div>
			<p class="eyebrow">MCC Formula Library</p>
			<h1 id="home-heading">A student's  <br><em>tool for a mondern classroom,</em></h1>
			<p class="intro-copy">A shared workspace for finding, understanding, and building the formulas that keep your coursework moving.</p>
			<div class="intro-actions">
				<a class="button button--primary" href="/all-formulas">Browse formulas <span aria-hidden="true">&#8594;</span></a>
				<% if (typeof user !== 'undefined' && user) { %>
					<a class="button button--quiet" href="/formula/create">Create a formula</a>
				<% } else { %>
					<a class="button button--quiet" href="/register">Join the library</a>
				<% } %>
			</div>
		</div>
		<div class="intro-mark" aria-hidden="true">
			<span class="mark-line mark-line--one"></span>
			<span class="mark-line mark-line--two"></span>
			<span class="mark-line mark-line--three"></span>
			<span class="mark-symbol">f<span>(x)</span></span>
		</div>
	</section>
	<section class="popular-formulas" aria-labelledby="popular-formulas-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Shared by the community</p>
				<h2 id="popular-formulas-heading">Popular formulas</h2>
			</div>
			<a class="text-link" href="/all-formulas">View all <span aria-hidden="true">&#8594;</span></a>
		</div>
		<p class="section-description">Explore the formulas being used and shared most often.</p>

		<div id="popular-formulas" class="formula-grid" aria-live="polite">
			<p class="loading-state">Loading popular formulas...</p>
		</div>
	</section>
</main>


<%- include('./partials/footer') %>




<script>
	fetch('/formula/?filter=popular')
		.then(function(response) {
			if (!response.ok) throw new Error('Failed to load formulas');
			return response.json();
		})
		.then(function(data) {
			var formulas = Array.isArray(data) ? data : (data.formulas || []);
			var container = document.getElementById('popular-formulas');
			container.replaceChildren();

			if (!formulas.length) {
				container.innerHTML = '<p class="empty-state">No popular formulas are available yet. Be the first to create one.</p>';
				return;
			}

			formulas.forEach(function(formula) {
				var card = document.createElement('article');
				card.className = 'formula-card';
				card.innerHTML = '<h2><a href="/formula/' + encodeURIComponent(formula.id) + '"></a></h2>' +
					(formula.description ? '<p></p>' : '') +
					(formula.author ? '<small></small>' : '');
				card.querySelector('a').textContent = formula.name;
				if (formula.description) card.querySelector('p').textContent = formula.description;
				if (formula.author) card.querySelector('small').textContent = 'Created by ' + formula.author;
				container.appendChild(card);
			});
		})
		.catch(function() {
			document.getElementById('popular-formulas').innerHTML = '<p class="empty-state">Unable to load popular formulas.</p>';
		});
</script>