<!doctype html>
<html lang="en" data-theme="leather">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark light" />
		<meta name="description" content="A senior capstone project for the MCC program.">
		<title><%= typeof title !== 'undefined' ? title : 'MCC Capstone' %></title>

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<script>
			(() => {
				const saved = localStorage.getItem('mcc-theme');
				if (saved) document.documentElement.dataset.theme = saved;
			})();
		</script>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const themeSelect = document.getElementById('theme-select');
				themeSelect.value = document.documentElement.dataset.theme || 'leather';
				themeSelect.addEventListener('change', ({ target }) => {
					document.documentElement.dataset.theme = target.value;
					localStorage.setItem('mcc-theme', target.value);
				});
			});
		</script>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">MCC Capstone</a>
			
			

			<nav class="main-nav" aria-label="Main navigation">
	<ul>
		<li><a href="/">Home</a></li>
		<li><a href="/formula/all">All Formulas</a></li>
		
		<% if (typeof user !== 'undefined' && user) { %>
			<li><a href="/formula/my">My Formulas</a></li>
			<li><a href="/formula/create">Create Formula</a></li>
			<li><a href="/account">Account</a></li>
		<% } else { %>
			<li><a href="/login">Login</a></li>
		<% } %>

		<li><label class="theme-picker" for="theme-select">
					
				<select id="theme-select" aria-label="Choose a theme">
					<option value="leather">Leather</option>
					<option value="dark">Dark</option>
					<option value="light">Light</option>
				</select>
			</label></li>
	</ul>
</nav>
</header>
		

		
