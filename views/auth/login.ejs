========================================================
 this page is the login page for the capstone project. It allows users to log in to their account by providing their username and password. The form data is sent to the server for authentication and access to the user's account.
========================================================
-->

<link rel="stylesheet" href="/css/theme.css">
<link rel="stylesheet" href="/css/auth.css">

<main class="auth-page">
	<section class="auth-card" aria-labelledby="login-title">
		<h1 id="login-title">Welcome back</h1>
		<p class="auth-subtitle">Sign in to your MCC Capstone account.</p>

		<form  method="post">
			<div class="form-field">
				<label for="username">Username</label>
				<input id="username" name="username" type="text" autocomplete="username" required>
			</div>

			<div class="form-field">
				<label for="password">Password</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required>
			</div>

			<button type="submit">Log in</button>
		</form>

		<!-- on submit redirect to home page  if return is the token -->
		 <script>
			document.querySelector('form').addEventListener('submit', function(e) {
				e.preventDefault();
				const formData = new FormData(this);
				const pyload = {
                    username: formData.get('username'),
                    email: formData.get('email'),
                    password: formData.get('password')
                };
				fetch('/auth/login', {
					method: 'POST',
					body: JSON.stringify(pyload),
                    headers: {
                        'Content-Type': 'application/json'
                    }
				})
				.then(response => response.json())
				.then(data => {
					if (data.token) {
						window.location.href = '/';
					}
				});
			});
		 </script>

		<p class="auth-footer">Need an account? <a href="/register">Create one</a></p>
	</section>
</main>



